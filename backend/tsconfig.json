{
  "compilerOptions": {
    "target": "ES2022",              // modern JS output
    "module": "NodeNext",             // Node-style ES modules
    "moduleResolution": "NodeNext",   // must match module
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}