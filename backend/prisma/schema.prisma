// ====================================================
// DISCORD SPACE SCHEMA (prefix "discord.")
// ====================================================

model DiscordUsers {
  discordId     String   @id @unique @map("discord_id") // Snowflake as string (verify at API level)
  globalName    String   @map("global_name")
  avatarHash    String?  @map("avatar_hash") // To construct avatar URLs
  // Are we also allowed to store a token? If not handle with cookies/session only

  accountCreated DateTime @map("account_created") // When the Discord account was created (obtain from API?)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("user") // Model name is DiscordUser for seperation of other spaces, but table can still be named "user"
	@@schema("discord")
  
  // Virtual Reverse Relations
  JoinedGuilds DiscordGuildMembers[]
  SentEventSuggestions EventSuggestions[]
  HostedEvents   DiscordEvents[] @relation("Host")
  CoHostedEvents DiscordEventCoHosts[]
  EventsApproved DiscordEvents[] @relation("Approver")
}

// Junction table for many-to-many relationship between DiscordUser and DiscordGuild
model DiscordGuildMembers {
  userId     String  @map("user_id") // Discord User Snowflake as string
  guildId    String  @map("guild_id") // Discord Guild Snowflake as string

  // Relevant App roles (Array of ENUMS, since a user can have multiple roles)
  roles       DiscordGuildRole[] @default([MEMBER])

  // Guild's actual roles could go in a discordRoles String[] if we want them

  // Akin to metadata
  joinedAt   DateTime @default(now()) @map("joined_at") // When the user joined the guild (can I get that from Discord?)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Virtual Relations
  user      DiscordUsers  @relation(fields: [userId], references: [discordId])
  guild     DiscordGuilds @relation(fields: [guildId], references: [guildId])

  @@id([userId, guildId])
  @@unique([userId, guildId])
  @@map("guild_member")
	@@schema("discord")
}

enum DiscordGuildRole {
  // GUEST (only guest when not logged in?)
  MEMBER          // Basic Member, can suggest basic events
  EVENT_TEAM      // ^ + Part of the team, can suggest detailed events
  EVENT_LEAD      // ^ + Part of the team, can approve or deny events and schedule them
  MODERATOR       // Different team, does not have access to event management, but can moderate content (future moderator dashboard for guild activity measurement)
  MODERATOR_LEAD  // ^ + Lead of the moderation team, can manage moderators and view analytics
  ADMIN           // Access to it ALL ^^^ (only manually assignable by me)
	@@schema("discord")
}

model DiscordGuilds {
  guildId       String  @id @unique @map("guild_id") // Snowflake as string (verify at API level) (NOTE: Will be just our server for the time being)
  guildName     String  @map("guild_name")
  iconHash      String? @map("icon_hash") // To construct icon URLs

  builtAt       DateTime @default(now()) @map("built_at") // When the guild was authored on discord (obtain from API?)
  createdAt     DateTime @default(now()) @map("created_at") // When the app first registered this guild
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Virtual Reverse Relations
  Events DiscordEvents[]
  EventSuggestions EventSuggestions[]
  Members DiscordGuildMembers[]

  @@map("guild")
	@@schema("discord")
}

model EventSuggestions {
  id            Int   @id @default(autoincrement())
  title         String
  description   String

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Foreign keys
  authorId      String   @map("author_id") // DiscordUser.discordId
  guildId       String   @map("guild_id") // DiscordGuild.guildId

  // Virtual relations
  author        DiscordUsers   @relation(fields: [authorId], references: [discordId])
  guild         DiscordGuilds  @relation(fields: [guildId], references: [guildId])

  @@map("suggestion")
	@@schema("discord")
}

