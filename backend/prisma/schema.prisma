/*
PRISMA CHEAT SHEET
==================

SETUP COMMANDS:
- npm run db:setup-schemas    # Create PostgreSQL schema namespaces (run once)
- npm run db:push            # Push schema changes to database
- npm run db:generate        # Generate TypeScript client
- npm run db:migrate         # Create migration files (production)
- npm run db:studio          # Visual database browser

RUN IN DOCKER:
# 1. Install dependencies
    docker-compose -f docker-compose.dev.yml exec backend npm install

# 2. Setup PostgreSQL schemas
    docker-compose -f docker-compose.dev.yml exec backend npm run db:setup-schemas

# 3. Push schema to database
    docker-compose -f docker-compose.dev.yml exec backend npm run db:push

# 4. Generate TypeScript client (usually auto-runs after db:push)
    docker-compose -f docker-compose.dev.yml exec backend npm run db:generate

COMMON FIELD TYPES:
- String, Int, Float, Boolean, DateTime
- String[] (arrays), Json, Bytes
- String? (optional), String @default("value")
- @id, @unique, @default(now()), @updatedAt

RELATIONSHIPS:
- author User @relation(fields: [authorId], references: [id])
- posts Post[] (one-to-many reverse)
- @@unique([field1, field2]) (composite unique)

INDEXES & MAPPING:
- @@map("custom_table_name")
- @map("custom_column_name") 
- @@index([field1, field2])

PRISMA CLIENT USAGE:
- prisma.model.findMany()
- prisma.model.create({ data: {...} })
- prisma.model.update({ where: {...}, data: {...} })
- prisma.model.delete({ where: {...} })
- prisma.model.findUnique({ where: {...} })
*/

// This is your main Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
	schemas  = ["public", "discord"]
}

// ====================================================
// GLOBAL/SHARED MODELS (Future auth, etc.) (no prefix)
// ====================================================

