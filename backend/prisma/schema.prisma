model DiscordEvents {
  id            Int 		 @id @default(autoincrement())
  eventId       String?  @unique @map("event_id") // Discord Event ID when made on Discord (if applicable)
  title         String
  description   String
  pingMessage   String   @map("ping_message") // Message to ping roles/users when event starts
  scheduledFor  DateTime @map("scheduled_for") // When the event is scheduled to
  expectedPrizes String? @map("expected_prizes") // Any expected prizes for participation (if applicable) (Future will be a relation to a Prizes table)
  estimatedDuration Int  @map("estimated_duration") // In minutes (Used for scheduling conflict checks and calendar view)
  approvalStatus ApprovalStatus @default(PENDING) @map("approval_status")
  status        EventStatus @default(PERMISSION_PENDING)

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  // Foreign keys
  hostId        String   @map("host_id") // DiscordUser.discordId
  approverId    String?  @map("approver_id") // DiscordUser.discordId
  guildId       String   @map("guild_id") // DiscordGuild.guildId

  // Virtual relations
  host          DiscordUsers   @relation("Host", fields: [hostId], references: [discordId])
  approver      DiscordUsers?  @relation("Approver", fields: [approverId], references: [discordId])
  guild         DiscordGuilds  @relation(fields: [guildId], references: [guildId])

  // Virtual Reverse Relations
  coHosts       DiscordEventCoHosts[]
  statistics    DiscordEventStatistics?
  
  @@map("event")
	@@schema("discord")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
	@@schema("public")
}

enum EventStatus {
  PERMISSION_PENDING
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
	@@schema("discord")
}

model DiscordEventCoHosts {
  eventId     Int  @map("event_id") // DiscordEvents.id
  coHostId    String  @map("co_host_id") // DiscordUsers.discordId
  response    ApprovalStatus @default(PENDING) // Co-host's response to willingness to co-host

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Virtual Relations
  event     DiscordEvents @relation(fields: [eventId], references: [id])
  coHost    DiscordUsers  @relation(fields: [coHostId], references: [discordId])

  @@id([eventId, coHostId])
  @@map("event_co_host")
	@@schema("discord")
}

model DiscordEventStatistics {
  eventId       Int			 @id @unique @map("event_id") // DiscordEvents.id
  startedAt     DateTime @map("started_at") // When the event actually started (for archive)
  endedAt       DateTime @map("ended_at") // When the event actually ended (for archive)
  averageAttendance Int  @map("average_attendance")
  peakAttendance Int     @map("peak_attendance")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Virtual Relations
  event         DiscordEvents @relation(fields: [eventId], references: [id]) // Not the discord event ID, but our internal ID as its possible the event isn't a discord internally created event

  @@map("event_statistics")
	@@schema("discord")
}

